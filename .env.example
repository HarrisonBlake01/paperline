# =========================================================
# Paperline — environment variables
# Copy this file to `.env.local` and fill in real values.
# Never commit `.env.local`.
# =========================================================

# --- App ---
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_NAME=Paperline
NEXT_PUBLIC_BRAND_OWNER=Olvera Productions

# --- Clerk (auth) ---
# Get from https://dashboard.clerk.com → API keys
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_SIGN_IN_FALLBACK_REDIRECT_URL=/dashboard
NEXT_PUBLIC_CLERK_SIGN_UP_FALLBACK_REDIRECT_URL=/dashboard
# Clerk webhook signing secret (Clerk Dashboard → Webhooks)
CLERK_WEBHOOK_SECRET=

# --- Supabase (DB + Storage) ---
# Get from https://supabase.com/dashboard → Project settings → API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Storage bucket names
SUPABASE_BUCKET_DOCUMENTS=documents

# --- OpenAI ---
# Get from https://platform.openai.com/api-keys
OPENAI_API_KEY=
OPENAI_EXTRACTION_MODEL=gpt-5.4
OPENAI_CHAT_MODEL=gpt-5.4
OPENAI_EMBEDDING_MODEL=text-embedding-3-large

# --- OCR (cost / quality controls) ---
# Max pages OCR'd per scanned PDF (rest are skipped, doc still ready).
PAPERLINE_OCR_MAX_PDF_PAGES=10
# Vision detail level: low (cheap), high (default), auto.
PAPERLINE_OCR_IMAGE_DETAIL=high
# Retry attempts per image on transient failure.
PAPERLINE_OCR_MAX_ATTEMPTS=2
# Concurrent vision calls per document.
PAPERLINE_OCR_CONCURRENCY=3

# --- Stripe ---
# Get from https://dashboard.stripe.com → Developers → API keys (use test keys to start)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
# Secure default: live Stripe keys are rejected unless launch is explicitly approved.
PAPERLINE_ALLOW_LIVE_STRIPE=false

# Price IDs (created in Stripe dashboard, then pasted here)
STRIPE_PRICE_PRO_MONTHLY=
STRIPE_PRICE_TEAM_MONTHLY=

# --- Inngest (background jobs) ---
# Get from https://www.inngest.com (optional in dev — has a local dev server)
INNGEST_EVENT_KEY=
INNGEST_SIGNING_KEY=

# --- Resend (transactional email) ---
# Get from https://resend.com/api-keys
RESEND_API_KEY=
EMAIL_FROM="Paperline <hello@paperline.io>"

# --- Sentry (error tracking) ---
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_ORG=
SENTRY_PROJECT=
SENTRY_AUTH_TOKEN=

# --- PostHog (product analytics) ---
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com

# --- Demo workspace (seeded for recruiters) ---
DEMO_WORKSPACE_ID=
DEMO_WORKSPACE_SLUG=demo
